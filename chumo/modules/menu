    echo -e "  \033[1;37mWEB-NGinx: \033[1;32m81\033[0m"
    msg -bar3
    echo -e " \033[1;37mâˆ˜ TOTAL: \033[1;33m${RAM_TOTAL}\033[1;37m âˆ˜  M|LIBRE: \033[1;32m${RAM_FREE}\033[1;37m  âˆ˜  EN USO: \033[1;31m${RAM_USED}\033[0m"
    echo -e " \033[1;37mâˆ˜ U/RAM: \033[1;33m${RAM_PCT}\033[1;37m  âˆ˜ U/CPU: \033[1;32m${CPU_PCT}\033[1;37m  âˆ˜ BUFFER: \033[1;36m${RAM_BUFF}\033[0m"
    msg -bar3
}

