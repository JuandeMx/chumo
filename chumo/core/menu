# TelemetrÃ­a Global
get_telemetry() {
    # Cache para no consultar internet en cada refresco de menÃº
    if [ -z "$GLOBAL_IP" ]; then
        GLOBAL_IP=$(curl -s4 --connect-timeout 2 --max-time 3 ipv4.icanhazip.com 2>/dev/null || wget -qO- --timeout=2 --tries=1 ipv4.icanhazip.com 2>/dev/null)
        if [ -z "$GLOBAL_IP" ]; then
            GLOBAL_IP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' || hostname -I | awk '{print $1}')
        fi
        [ -z "$GLOBAL_IP" ] && GLOBAL_IP="127.0.0.1"
    fi
    IP="$GLOBAL_IP"
    
    if [ -z "$GLOBAL_OS" ]; then
        GLOBAL_OS=$(grep -w PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')
        [ -z "$GLOBAL_OS" ] && GLOBAL_OS="Ubuntu 20.04"
    fi
    OS="$GLOBAL_OS"
    
    FECHA=$(date +"%d-%m-%Y")
    HORA=$(date +"%H:%M:%S")

    # Disco
    DISC_TOTAL=$(df -h / | awk 'NR==2 {print $2}')
    DISC_USO=$(df -h / | awk 'NR==2 {print $3}')
    DISC_FREE=$(df -h / | awk 'NR==2 {print $4}')
    DISC_DISP=$(df -h / | awk 'NR==2 {print $4}')

    # CPU (Optimizado: Leer /proc/loadavg en lugar de ejecutar top -bn1)
    CORES=$(nproc)
    if [ -f /proc/loadavg ]; then
        local load1
        load1=$(awk '{print $1}' /proc/loadavg)
        CPU_USE=$(awk -v l1="$load1" 'BEGIN {printf "%.2f%%", l1 * 10}')
    else
        CPU_USE="0.00%"
    fi

    # RAM
    RAM_TOTAL=$(free -m | awk 'NR==2 {printf "%.2fGB", $2/1024}')
    RAM_USO=$(free -m | awk 'NR==2 {printf "%.2fGB", $3/1024}')
    RAM_FREE=$(free -m | awk 'NR==2 {printf "%.2fMB", $4}')
    RAM_BUFF=$(awk '/Buffers:/ {printf("%.2fMB", $2/1024)}' /proc/meminfo)
    RAM_CACHE=$(awk '/^Cached:/ {printf("%.2fMB", $2/1024)}' /proc/meminfo)

    # Cuentas SSH (Optimizado: Sin forks de 'date' en el bucle)
    TOTAL=0
    ACTIVA=0
    EXPIRADA=0
    
    if [ -s "$USER_DB" ]; then
        TOTAL=$(grep -c -v "^$" "$USER_DB")
        local fecha_actual_sec
        fecha_actual_sec=$(date +%s)
        local fecha_actual_ymd
        fecha_actual_ymd=$(date +%Y-%m-%d)
        
        while IFS=: read -r d_user d_pass d_exp d_hwid d_limit d_alias; do
            # Validar que no sea lÃ­nea vacÃ­a
            [ -z "$d_user" ] && continue
            [ -z "$d_exp" ] && continue
            
            # Si empieza con @ es epoch (usuario temporal)
            if [[ "$d_exp" == @* ]]; then
                local exp_sec="${d_exp#@}"
                if [[ "$exp_sec" =~ ^[0-9]+$ ]]; then
                    if [ "$exp_sec" -ge "$fecha_actual_sec" ]; then
                        ACTIVA=$((ACTIVA+1))
                    else
                        EXPIRADA=$((EXPIRADA+1))
                    fi
                else
                    EXPIRADA=$((EXPIRADA+1))
                fi
            # Es fecha estÃ¡ndar YYYY-MM-DD
            elif [[ "$d_exp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
                if ! [[ "$d_exp" < "$fecha_actual_ymd" ]]; then
                    ACTIVA=$((ACTIVA+1))
                else
                    EXPIRADA=$((EXPIRADA+1))
                fi
            else
                # Fallback seguro para otros formatos
                local exp_sec
                exp_sec=$(date -d "$d_exp" +%s 2>/dev/null)
                if [ -n "$exp_sec" ]; then
                    if [ "$exp_sec" -ge "$fecha_actual_sec" ]; then
                        ACTIVA=$((ACTIVA+1))
                    else
                        EXPIRADA=$((EXPIRADA+1))
                    fi
                else
                    EXPIRADA=$((EXPIRADA+1))
                fi
            fi
        done < "$USER_DB"
    fi
    
    BLOQUEADA=0
}


