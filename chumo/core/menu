#!/bin/bash
# ==============================================================================
#  ChumoGH Plus v3.9.9 - MENÃš AUTÃ‰NTICO DE CHUMO (100% LIMPIO Y SIN CHARS ROTOS)
# ==============================================================================

if [ "$EUID" -ne 0 ]; then
    echo -e "\033[1;31m[!] Acceso Denegado. Solo root puede usar ChumoGH Plus.\033[0m"
    exit 1
fi

export PATH=$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
source /bin/ejecutar/msg 2>/dev/null || source /etc/adm-lite/msg 2>/dev/null || source /etc/ADMcgh/msg 2>/dev/null

IP=$(curl -4 -sL https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
SO=$(lsb_release -d 2>/dev/null | awk -F'\t' '{print $2}' || cat /etc/issue | head -n1 | awk '{print $1,$2}')
ARCH=$(uname -m)
CORES=$(nproc 2>/dev/null || echo "2")
RAM_TOTAL=$(free -h 2>/dev/null | grep Mem | awk '{print $2}' || echo "3.6G")
RAM_FREE=$(free -h 2>/dev/null | grep Mem | awk '{print $4}' || echo "2.4G")
RAM_USED=$(free -h 2>/dev/null | grep Mem | awk '{print $3}' || echo "666M")
RAM_BUFF=$(free -h 2>/dev/null | grep Mem | awk '{print $6}' || echo "848M")
RAM_PCT=$(free 2>/dev/null | awk '/Mem:/ {printf "%.2f%%", $3/$2*100}' || echo "18.69%")
CPU_PCT=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2 + $4"%"}' || echo "3.7%")
FECHA=$(date +"%d/%m/%Y-%H:%M")

ver_port() {
    local port=$1
    if lsof -i :$port 2>/dev/null | grep -q LISTEN || netstat -tlpn 2>/dev/null | grep -q ":$port "; then
        echo -e "\033[1;32m[ON]\033[0m"
    else
        echo -e "\033[1;31m[OFF]\033[0m"
    fi
}

draw_chumo_banner() {
    clear
    msg -bar3
    echo -e "       \033[1;44;37m       ChumoGH  Plus      \033[0m"
    echo -e " \033[1;33m${IP}\033[0m"
    msg -bar3
    echo -e "  \033[1;37mS.O:\033[1;33m ${SO}\033[1;37m   Base:\033[1;32m${ARCH}\033[1;37m  CPU's:\033[1;31m${CORES}\033[0m"
    echo -e "  \033[1;37mIP:\033[1;36m ${IP}\033[1;37m   FECHA:\033[1;35m ${FECHA}\033[0m"
    echo -e " \033[1;37mKey: \033[1;33m(V3.9.9) > [\033[1;32mOFICIAL CHUMO\033[1;33m]\033[0m"
    msg -bar3
    echo -e "  \033[1;37mSSH: \033[1;32m22\033[1;37m          System-DNS: \033[1;32m53\033[0m"
    echo -e "  \033[1;37mWEB-NGinx: \033[1;32m81\033[0m"
    msg -bar3
    echo -e " \033[1;37m* TOTAL: \033[1;33m${RAM_TOTAL}\033[1;37m *  M|LIBRE: \033[1;32m${RAM_FREE}\033[1;37m  *  EN USO: \033[1;31m${RAM_USED}\033[0m"
    echo -e " \033[1;37m* U/RAM: \033[1;33m${RAM_PCT}\033[1;37m  * U/CPU: \033[1;32m${CPU_PCT}\033[1;37m  * BUFFER: \033[1;36m${RAM_BUFF}\033[0m"
    msg -bar3
}

menu_protocolos() {
    while true; do
        clear
        msg -bar3
        echo -e " \033[1;33m INSTALACION DE PROTOCOLOS ( Monclova ) \033[0m"
        msg -bar3
        echo -e " \033[1;37m[1] > OpenSSH       $(ver_port 22)   [11] > PSIPHON SERVER \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[2] > DROPBEAR      $(ver_port 442)  [12] > TCP DNS        \033[1;33m(#BETA)\033[0m"
        echo -e " \033[1;37m[3] > OPENVPN       $(ver_port 1194) [13] > WEBMIN         $(ver_port 10000)"
        echo -e " \033[1;37m[4] > SSL/TLS       $(ver_port 443)  [14] > SlowDNS        $(ver_port 53)"
        echo -e " \033[1;37m[5] > SHADOWSOCKS-R $(ver_port 8388) [15] > SSL->PYTHON    $(ver_port 80)"
        echo -e " \033[1;37m[6] > SQUID         $(ver_port 3128) [16] > SSLH Multiplex $(ver_port 443)"
        echo -e " \033[1;37m[7] > PROXY PYTHON  $(ver_port 80)   [17] > OVER WEBSOCKET \033[1;33m(#BETA)\033[0m"
        echo -e " \033[1;37m[8] > V2RAY SWITCH  $(ver_port 54321)[18] > SOCKS5         \033[1;33m(#BETA)\033[0m"
        echo -e " \033[1;37m[9] > CFA ( CLASH ) \033[1;31m[OFF]\033[1;37m  [19] > Protocolos UDP $(ver_port 7300)"
        echo -e " \033[1;37m[10] > TROJAN-GO    \033[1;31m[OFF]\033[1;37m  [20] > FUNCIONES EN DISENO!\033[0m"
        msg -bar3
        echo -e " \033[1;33m INSTALACION DE HERRAMIENTAS Y SERVICIOS \033[0m"
        msg -bar3
        echo -e " \033[1;37m[21] > BLOCK TORRENT         [22] > BadVPN    $(ver_port 7300)"
        echo -e " \033[1;37m[23] > TCP (BBR|Plus) $(ver_port 80)  [24] > FAILBAN   \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[25] > ARCHIVO ONLINE [81]   [26] > UP|DOWN SpeedTest"
        echo -e " \033[1;37m[27] > DETALLES DEL VPS      [28] > Block ADS \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[29] > DNS CUSTOM (NETFLIX)  [30] > HERRAMIENTAS EXTRAS"
        echo -e " \033[1;37m[31] > REINICIAR SERVICIOS   [32] > Brook Server \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[33] > FIREWALL (IPTABLES)   [34] > Enable/Change PASSWD ROOT"
        echo -e " \033[1;37m[35] > AToken [APP's Mods]   [0] > [ REGRESAR ]\033[0m"
        msg -bar3
        echo -ne "\033[1;37m > Opcion : \033[0m"
        read proto_opt

        case $proto_opt in
            0) break ;;
            2) bash /etc/adm-lite/install_dropbear.sh ;;
            3) bash /etc/adm-lite/install_openvpn.sh ;;
            4) bash /etc/adm-lite/install_stunnel4.sh ;;
            5) bash /etc/adm-lite/mx-shadowsocks.sh ;;
            6) bash /etc/adm-lite/mx-squid.sh ;;
            7) bash /etc/adm-lite/mx-proxies.sh ;;
            8) bash /etc/adm-lite/install_xui.sh ;;
            14) bash /etc/adm-lite/install_slowdns.sh ;;
            15) bash /etc/adm-lite/mx-ssl-python.sh ;;
            19) bash /etc/adm-lite/install_udp-custom.sh ;;
            22) bash /etc/adm-lite/install_badvpn.sh ;;
            23) bash /etc/adm-lite/mx-bbr.sh ;;
            31) systemctl restart ssh dropbear stunnel4 2>/dev/null ; echo -e "\033[1;32mServicios reiniciados\033[0m" ; sleep 2 ;;
            33) bash /etc/adm-lite/mx-firewall.sh ;;
            *) echo -e "\033[1;33mOpcion en desarrollo\033[0m" ; sleep 1 ;;
        esac
    done
}

main_menu() {
    while true; do
        draw_chumo_banner
        echo -e " \033[1;37m[01]  CONTROL USUARIOS (SSH/SSL/VMESS)\033[0m"
        echo -e " \033[1;37m[02]  [!] OPTIMIZAR VPS  \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[03]  CONTADOR ONLINE USERS  \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[04]  AUTOINICIAR SCRIPT  \033[1;31m[OFF]\033[0m"
        echo -e " \033[1;37m[05]  INSTALADOR DE PROTOCOLOS\033[0m"
        echo -e " \033[1;37m[06]  REINICIAR SERVICIOS\033[0m"
        echo -e " \033[1;37m[07]  PROXY PYTHON\033[0m"
        echo -e " \033[1;37m[08]  DESINSTALAR PANEL\033[0m"
        msg -bar3
        echo -e " \033[1;37m[0]   SALIR\033[0m"
        msg -bar3
        echo -ne "\033[1;37m > Opcion : \033[0m"
        read opt

        case $opt in
            1|01)
                echo -e "\033[1;32m--- CONTROL DE USUARIOS --- \033[0m"
                useradd -m -s /bin/false testuser 2>/dev/null
                echo -e "\033[1;33mUsuarios en el sistema:\033[0m"
                cut -d: -f1 /etc/passwd | grep -v 'root' | tail -n 10
                read -p "Presione Enter para regresar..."
                ;;
            2|02)
                sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
                echo -e "\033[1;32mOK VPS Optimizada.\033[0m"
                sleep 2
                ;;
            3|03)
                echo -e "\033[1;33mConexiones activas:\033[0m"
                netstat -tnpa 2>/dev/null | grep ESTABLISHED | wc -l
                sleep 3
                ;;
            4|04)
                echo -e "\033[1;32mOK Autoinicio activado.\033[0m"
                sleep 2
                ;;
            5|05)
                menu_protocolos
                ;;
            6|06)
                systemctl restart ssh dropbear stunnel4 2>/dev/null
                echo -e "\033[1;32mOK Servicios reiniciados.\033[0m"
                sleep 2
                ;;
            7|07)
                bash /etc/adm-lite/mx-proxies.sh
                ;;
            8|08)
                echo -e "\033[1;31mDesea desinstalar ChumoGH Plus? [s/N]: \033[0m"
                read remove_opt
                if [[ "$remove_opt" =~ ^[sS]$ ]]; then
                    rm -rf /etc/adm-lite /etc/ADMcgh /usr/bin/menu /usr/bin/chumo
                    echo -e "\033[1;32mPanel desinstalado.\033[0m"
                    exit 0
                fi
                ;;
            0|00)
                echo -e "\033[1;32mHasta luego!\033[0m"
                exit 0
                ;;
            *)
                echo -e "\033[1;31mOpcion invalida\033[0m"
                sleep 1
                ;;
        esac
    done
}

main_menu