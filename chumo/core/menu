sub_zombies() {
    ui_header "ESCANER DE HILOS ZOMBIS"
    echo -e " ${CYAN}Analizando sockets colgados (CLOSE_WAIT)...${NC}"
    
    # Solo CLOSE_WAIT son verdaderos zombis (fugas de memoria).
    # TIME_WAIT es un estado temporal normal del kernel de Linux.
    local zombies=$(netstat -an | grep -E 'CLOSE_WAIT' | wc -l)
    
    if [ "$zombies" -gt 50 ]; then
        echo -e "\n ${RED}âš ï¸ Â¡ALERTA! Se detectaron $zombies conexiones zombis retenidas.${NC}"
        echo -e " Esto puede saturar la memoria y causar errores EOF Reached."
    elif [ "$zombies" -gt 0 ]; then
        echo -e "\n ${YELLOW}âš ï¸ Se detectaron $zombies conexiones colgadas (zombis).${NC}"
        echo -e " Es un nivel bajo, el sistema puede auto-purgarlas poco a poco."
    else
        echo -e "\n ${GREEN}âœ… El sistema estÃ¡ limpio. 0 conexiones zombis encontradas.${NC}"
    fi

    echo -e "\n ${CYAN}[1]>${WHITE} Purgar Zombis ahora (Reinicia los tÃºneles y libera RAM)${NC}"
    echo -e " ${CYAN}[0]>${WHITE} Volver${NC}"
    ui_prompt "OpciÃ³n: "
    read opt_z
    if [ "$opt_z" == "1" ]; then
        echo -e "\n${YELLOW}â–¶ Ejecutando limpieza profunda de tÃºneles...${NC}"
        systemctl restart dropbear stunnel4 mx-proxy ws-epro >/dev/null 2>&1
        sync; echo 3 > /proc/sys/vm/drop_caches
        echo -e "${GREEN}âœ… Â¡Zombis eliminados exitosamente! Servidor al 100%.${NC}"
        sleep 2
    fi
}

