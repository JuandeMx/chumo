                    sed -i "/^$del_key:/d" /etc/adm-lite/keys.db
                    echo -e "${GREEN}âœ… Key $del_key eliminada.${NC}"
                else
                    echo -e "${RED}âŒ Key no encontrada.${NC}"
                fi
                ui_pause
                ;;
            4)
                systemctl stop maximus-tunnel 2>/dev/null
                systemctl stop maximus-keyserver 2>/dev/null
                systemctl disable maximus-tunnel 2>/dev/null
                rm -f /tmp/cf_dynamic.conf
                rm -f /etc/adm-lite/cf_tunnel.url
                echo -e "${RED}âœ… Servidor y TÃºnel detenidos (Systemd).${NC}"
                ui_pause
                ;;
            5)
                ui_header "CONFIGURAR DOMINIO O CLOUDFLARE"
                
                # Auto-Iniciar Servidor Python si estÃ¡ apagado
                if ! systemctl is-active --quiet maximus-keyserver; then
                    echo -e "${CYAN}[+] Iniciando Servidor Python (Systemd)...${NC}"
                    systemctl stop maximus-keyserver 2>/dev/null
                    pkill -9 -f '[k]ey_server.py' >/dev/null 2>&1
                    fuser -k 6767/tcp >/dev/null 2>&1
                    systemctl enable maximus-keyserver 2>/dev/null
                    systemctl start maximus-keyserver 2>/dev/null
                    sleep 2
                fi
                
                echo -e "  ${CYAN}[1]${WHITE} Ingresar Dominio/IP Personalizado"
                echo -e "  ${CYAN}[2]${WHITE} Generar Dominio AutomÃ¡tico (Cloudflare Tunnel)"
                echo -e "  ${CYAN}[3]${WHITE} Limpiar ConfiguraciÃ³n (Usar IP PÃºblica)"
                echo -n "  Selecciona una opciÃ³n: "
                read d_opt
                
                if [ "$d_opt" == "1" ]; then
                    echo -e "Ejemplo: https://midominio.com (o http://192.168.1.1:6767)"
                    read -p "Ingresa tu Dominio/IP Base: " new_domain
                    if [ -n "$new_domain" ]; then
                        # Quitar http:// o https:// temporalmente para analizar el host y puerto
                        temp_domain=${new_domain#http://}
                        temp_domain=${temp_domain#https://}
                        
                        # Si no contiene ":" (no hay puerto especificado)
                        if [[ "$temp_domain" != *:* ]]; then
                            # Si la entrada original no empieza con https:// (que usa 443 implÃ­cito)
                            if [[ "$new_domain" != https://* ]]; then
                                # AÃ±adir puerto del keyserver
                                new_domain="${new_domain}:6767"
                            fi
                        fi
                        
                        if [[ "$new_domain" != http://* ]] && [[ "$new_domain" != https://* ]]; then
                            new_domain="http://$new_domain"
                        fi
                        echo "$new_domain" > /etc/adm-lite/domain.conf
                        rm -f /tmp/cf_dynamic.conf
                        rm -f /etc/adm-lite/cf_tunnel.url
                        systemctl stop maximus-tunnel 2>/dev/null
                        systemctl disable maximus-tunnel 2>/dev/null
                        
                        systemctl start maximus-keyserver 2>/dev/null
                        echo -e "${GREEN}âœ… Dominio configurado y Servidor Activo en: $new_domain${NC}"
                    fi
                elif [ "$d_opt" == "2" ]; then
                    echo -e "${CYAN}â˜ï¸ Generando Dominio Anti-Firewall con Cloudflare (Systemd)...${NC}"
                    rm -f /etc/adm-lite/domain.conf
                    rm -f /etc/adm-lite/cf_tunnel.url
                    
                    # Detener y limpiar tÃºneles anteriores
                    systemctl stop maximus-tunnel 2>/dev/null
                    pkill -9 -f '[c]loudflared' >/dev/null 2>&1
                    
                    # Asegurar Keyserver activo sin conflictos de puerto
                    systemctl stop maximus-keyserver 2>/dev/null
                    pkill -9 -f '[k]ey_server.py' >/dev/null 2>&1
                    fuser -k 6767/tcp >/dev/null 2>&1
                    systemctl start maximus-keyserver 2>/dev/null
                    
                    # Copiar definiciÃ³n del servicio si no existe
                    if [ -f /etc/adm-lite/core/maximus-tunnel.service ]; then
                        cp /etc/adm-lite/core/maximus-tunnel.service /etc/systemd/system/
                        systemctl daemon-reload
                    fi
                    
                    systemctl enable maximus-tunnel 2>/dev/null
                    systemctl start maximus-tunnel 2>/dev/null
                    
                    echo -e "${WHITE}Esperando asignaciÃ³n de dominio seguro (aprox 10 seg)...${NC}"
                    sleep 10
                    
                    cf_url=$(cat /etc/adm-lite/cf_tunnel.url 2>/dev/null)
                    if [ -n "$cf_url" ]; then
                        echo -e "${GREEN}âœ… Dominio generado: ${cf_url}${NC}"
                        echo "$cf_url" > /tmp/cf_dynamic.conf
                    else
                        # Fallback a ver si el log tiene algo
                        cf_url=$(grep -o 'https://[-a-zA-Z0-9]*\.trycloudflare\.com' /var/log/maximus_tunnel.log 2>/dev/null | head -n 1)
                        if [ -n "$cf_url" ]; then
                            echo "$cf_url" > /etc/adm-lite/cf_tunnel.url
                            echo "$cf_url" > /tmp/cf_dynamic.conf
                            echo -e "${GREEN}âœ… Dominio generado: ${cf_url}${NC}"
                        else
                            echo -e "${RED}âŒ FallÃ³ Cloudflare. Verifica /var/log/maximus_tunnel.log${NC}"
                        fi
                    fi
                elif [ "$d_opt" == "3" ]; then
                    rm -f /etc/adm-lite/domain.conf
                    rm -f /tmp/cf_dynamic.conf
                    rm -f /etc/adm-lite/cf_tunnel.url
                    systemctl stop maximus-tunnel 2>/dev/null
                    systemctl disable maximus-tunnel 2>/dev/null
                    echo -e "${YELLOW}âš ï¸ Dominio reseteado a la IP por defecto.${NC}"
                fi
                ui_pause
                ;;
            0) return ;;
        esac
    done
}

